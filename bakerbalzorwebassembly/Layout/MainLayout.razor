@inherits LayoutComponentBase   
<div class="container-fluid">
    <div class="row flex-row-reverse">

        <div class="col-md-3 col-lg-2 d-none d-md-block sidebar-container">
            <Sidebar />
        </div>

    
        <div class="col-md-9 ms-auto col-lg-10 px-md-4">
            <div class="d-md-none mobile-nav">
                <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
                    ☰ القائمة
                </button>
            </div>

            <main>
                @Body
            </main>
        </div>
    </div>
</div>


<div class="offcanvas offcanvas-end" tabindex="-1" id="mobileSidebar">
    <div class="offcanvas-header">

        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <Sidebar />
    </div>
</div>


