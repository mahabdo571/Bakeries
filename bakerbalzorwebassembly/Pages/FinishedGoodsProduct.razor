@page "/finishedGoodsProduct"
@using Business.Shared.DTOs
@using Business.Shared.Enums
@using bakerbalzorwebassembly.Component.FinishedGoodsProduct
@using bakerbalzorwebassembly.Component.Shared
@using bakerbalzorwebassembly.Models
@inherits ComponentBase
<PageTitle>المنتجات التي يتم تصنيعها</PageTitle>
<h3 class="mb-4">
    <i class="bi bi-inboxes"></i> المنتجات التي يتم تصنيعها
</h3>

<PageToolbar SearchText="@searchText"
             OnSearch="@Search"
             OnAdd="ShowAddModal"
             ShowButtonAddNew="@true" />


<FinishedGoodsProductTable Items="@filteredData"
                           OnDetails="ShowDetails"
                           OnEdit="ShowEdit"
                           OnDelete="ShowDelete"
                           OnClickToOpenProductComponents="OpenProductComponents"
                           OnClickToOpenProduction="OpenProduction" />


<DetailsModal Item="@selectedForDetails"
              OnClose="CloseDetails" />

<EditModal Item="@selectedForEdit"
           OnSave="@SavePurchases"
           OnClose="@CloseEditModal" />


<DeleteModal Item="@selectedForDelete"
             OnConfirm="ConfirmDelete"
             OnClose="CloseDeleteModal" />

<LoadingModal IsVisible="@isSaving" />

<ErrorModal Message="@messageError"
            OnClose="CloseDeleteModal" />

@code {
    @inject NavigationManager Navigation;
    @inject NavigationMode navModel;
    private void OpenProductComponents(ProductDTO model)
    {
        var baseUri = Navigation.BaseUri;
        navModel.restState();
        navModel.productDTO = model;

        Navigation.NavigateTo($"{baseUri}productComponents");


    }  
    
    private void OpenProduction(ProductDTO model)
    {
        var baseUri = Navigation.BaseUri;
        navModel.restState();
        navModel.productDTO = model;

        Navigation.NavigateTo($"{baseUri}production");


    }
}