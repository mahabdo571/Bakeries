@page "/salesReport"
@using System.Globalization
@using Business.Shared.DTOs
@using bakerbalzorwebassembly.Services

<h3 class="page-title">تقرير البيانات  </h3>

<div class="filter-section">
    <div class="date-filters">
        <div class="date-input">
            <label>تاريخ البداية:</label>
            <input type="date"
            @bind="startDate"
            class="form-control"
            max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>

        <div class="date-input">
            <label>تاريخ النهاية:</label>
            <input type="date"
            @bind="endDate"
            class="form-control"
            max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>

        <button @onclick="FilterData"
        class="filter-btn">
            <i class="fas fa-filter"></i> تصفية
        </button>
    </div>

    @if (hasError)
    {
        <div class="alert alert-danger">
            ❌ تاريخ البداية يجب أن يكون قبل تاريخ النهاية
        </div>
    }
</div>

@if (isLoading)
{
    <div class="loading">
        <i class="fas fa-spinner fa-spin"></i> جاري التحميل...
    </div>
}
else if (filteredData.Any())
{
    <div class="responsive-table">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>التاريخ</th>
                    <th>العنوان</th>
                    <th>المبلغ</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in filteredData)
                {
                    <tr>
                        <td>@item.TotalSales</td>
                        <td>@item.SaleDate.ToShortDateString()</td>
                        <td>@item.DayName</td>
                        <td class="@GetAmountClass(item.TotalSales)">@item.TotalSales.ToString("C")</td>
                        <td>
                            @if (item.TotalItems ==1)
                            {
                                <i class="fas fa-check-circle text-success"></i>
                            }
                            else
                            {
                                <i class="fas fa-times-circle text-danger"></i>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="summary">
        <span>عدد السجلات: @filteredData.Count</span>
        <span>المجموع: @filteredData.Sum(x => x.TotalSales).ToString("C")</span>
    </div>
}
else
{
    <div class="no-data">
        ⚠️ لا توجد بيانات في النطاق الزمني المحدد
    </div>
}

@code {
    private DateTime startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime endDate = DateTime.Today;
    private List<SalesReportDTO> reportData = new();
    private List<SalesReportDTO> filteredData = new();
    private bool isLoading = true;
    private bool hasError = false;

    [Inject]
    protected SalesReportService MyService { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await GenerateDummyData();
        FilterData();
        isLoading = false;
    }

    private async Task GenerateDummyData()
    {

        reportData = await MyService.GetAsync(startDate,endDate);
    }

    private void FilterData()
    {
        if (startDate > endDate)
        {
            hasError = true;
            return;
        }

        hasError = false;
        filteredData = reportData
            .Where(x => x.SaleDate >= startDate && x.SaleDate <= endDate)
            .OrderBy(x => x.SaleDate)
            .ToList();
    }

    private string GetAmountClass(decimal amount) =>
        amount > 100 ? "high-amount" : amount > 50 ? "medium-amount" : "";

 
}

