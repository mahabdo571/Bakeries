@page "/PurchasingAndInvoc"
@using Business.Shared.DTOs
@using Business.Shared.Enums
@using bakerbalzorwebassembly.Component.Purchasing
@using bakerbalzorwebassembly.Component.Shared
@using bakerbalzorwebassembly.Models
@inherits ComponentBase

<h3 class="mb-4">
    <i class="bi bi-receipt"></i>
    المشتريات والفواتير @(!string.IsNullOrEmpty(navigationMode?.stockDTO?.ItemName) ? " للمنتج " + navigationMode?.stockDTO?.ItemName : "للعرض فقط")
</h3>


<PageToolbar SearchText="@searchText"
OnSearch= "@SearchPurchasing"
OnAdd="ShowAddModal" 
ShowButtonAddNew="@(navigationMode?.stockDTO is not null)"
/>
@if(navigationMode is not null && navigationMode.isAllRested()){
  <CombinedPurchaseTable Items="@FilteredCombinedPurchase"
      OnDetails="ShowDetailsCombinedPurchase"
          />

    <CombinedPurchaseDetails Item="@selectedCombinedPurchaseForDetails"
                             OnClose="CloseDetails" />
}
else
{
    <PurchasingTable Items="@FilteredPurchases"
                     OnDetails="ShowDetails"
                     OnEdit="ShowEdit"
                     OnDelete="ShowDelete"
                     navMod="navigationMode?.stockDTO" />

    <DetailsModal Item="@selectedPurchasingForDetails"
                  OnClose="CloseDetails" />
}





<EditModal
    Item="@selectedPurchasingForEdit"

    OnSave="@SavePurchases"
    OnClose="@CloseEditModal"
    navigationItem="navigationMode?.stockDTO"
    OnQuantityChanged="@OnQuantityChanged"
    OnUnitPriceChanged="@OnUnitPriceChanged" />

<DeleteModal 
    Item="@selectedPurchasingForDelete"
    OnConfirm="ConfirmDelete"
    OnClose="CloseDeleteModal" />

<LoadingModal IsVisible="@isSaving" />

<ErrorModal 
    Message="@messageError"
    OnClose="CloseDeleteModal" />

  