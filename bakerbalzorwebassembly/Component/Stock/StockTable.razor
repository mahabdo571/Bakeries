@inherits ComponentBase
@using Business.Shared.DTOs
@using Business.Shared.Enums.Extensions

<div class="table-responsive">
    <table class="table-striped table-hover table">
        <thead class="table-dark">
            <tr>
                <!-- تظهر فقط على سطح المكتب -->
                <th class="d-none d-md-table-cell">#</th>
                <th>اسم العنصر</th>
                <th>الكمية المتوفرة</th>
                <th class="d-none d-md-table-cell">وحدة القياس</th>
                <th class="d-none d-md-table-cell">الحد الأدنى</th>
                <th class="d-none d-md-table-cell">الموقع</th>
                <th class="d-none d-md-table-cell">الملاحظات</th>
                <th class="d-none d-md-table-cell">تاريخ الإنشاء</th>
                <th class="d-none d-md-table-cell">تاريخ التعديل</th>
                <th>الإجراءات</th>

            </tr>
        </thead>
        <tbody>
            @if (Items == null)
            {
                <tr><td colspan="10" class="text-center">جاري التحميل...</td></tr>
            }
            else if (!Items.Any())
            {
                <tr><td colspan="10" class="text-center">لا توجد بيانات</td></tr>
            }
            else
            {
                @foreach (var item in Items)
                {
                    <tr @onclick="() => OnDetails.InvokeAsync(item)" style="cursor: pointer;">
                        <td class="d-none d-md-table-cell">@item.Id</td>
                        <td>@item.ItemName</td>
                        <td>@item.AvailableQuantity</td>
                        <td class="d-none d-md-table-cell">@item.UnitOfMeasure.GetDisplayName()</td>
                        <td class="d-none d-md-table-cell">@item.ReorderLevel</td>
                        <td class="d-none d-md-table-cell">@item.Location</td>
                        <td class="d-none d-md-table-cell">@item.Notes</td>
                        <td class="d-none d-md-table-cell">
                            @(item.CreatedAt.HasValue ? item.CreatedAt.Value.ToString("yyyy-MM-dd") : "-")
                        </td>
                        <td class="d-none d-md-table-cell">
                            @(item.UpdatedAt.HasValue ? item.UpdatedAt.Value.ToString("yyyy-MM-dd") : "-")
                        </td>

                        <td>
                            <button title="المشتريات والفواتير الخاصة بالمنتج" class="btn btn-sm btn-success me-1"
                            @onclick:stopPropagation
                                    @onclick="() => OnClickToOpenPurchasing.InvokeAsync(item)">
                                <i class="bi bi-receipt"></i>
                            </button>
                            <button class="btn btn-sm btn-warning me-1"
                            @onclick:stopPropagation
                                    @onclick="() => OnEdit.InvokeAsync(item)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-danger"
                            @onclick:stopPropagation
                                    @onclick="() => OnDelete.InvokeAsync(item)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IEnumerable<StockDTO> Items { get; set; }
    [Parameter] public EventCallback<StockDTO> OnDetails { get; set; }
    [Parameter] public EventCallback<StockDTO> OnEdit { get; set; }
    [Parameter] public EventCallback<StockDTO> OnDelete { get; set; }
    [Parameter] public EventCallback<StockDTO> OnClickToOpenPurchasing { get; set; }
}