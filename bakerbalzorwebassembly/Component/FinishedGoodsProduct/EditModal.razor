@inherits ComponentBase
@using Business.Shared.DTOs
@using Business.Shared.Enums
@using Business.Shared.Enums.Extensions



@if (Item is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(Item.Id == 0 ? "إضافة منتج" : "تعديل منتج")
                    </h5>
                    <button type="button" class="btn-close" @onclick="@OnClose"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="Item" OnValidSubmit="@HandleSave">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label">اسم العنصر</label>

                            <InputText class="form-control"
                                         @bind-Value="Item.Name" />
                        </div>
     
            
                        <div class="mb-3">
                            <label class="form-label">سعر الوحدة</label>
                            <InputNumber class="form-control"
                                         @bind-Value="Item.Price"
                                         />


                        </div>
           
                        <div class="mb-3">
                            <label class="form-label">وحدة القياس</label>
                            <InputSelect class="form-control" @bind-Value="Item.UnitOfMeasureId">
                                <option value="0">اختر وحدة القياس</option>
                                @foreach (var unit in Enum.GetValues<UnitOfMeasure>())
                                {
                                    <option value="@((int)unit)">@unit.GetDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
           

                        <div class="mb-3">
                            <label class="form-label">تفاصيل اضافية</label>
                            <InputTextArea class="form-control" @bind-Value="Item.Description" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">الملاحظات</label>
                            <InputTextArea class="form-control" @bind-Value="Item.Notes" />
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">حفظ</button>
                            <button type="button" class="btn btn-secondary" @onclick="OnClose">إغلاق</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}


@code {




    [Parameter] public ProductDTO Item { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnQuantityChanged { get; set; }
    [Parameter] public EventCallback<string> OnUnitPriceChanged { get; set; }



    private async Task HandleSave()
    {
        await OnSave.InvokeAsync();
    }


}