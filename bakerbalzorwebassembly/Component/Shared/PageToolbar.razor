@using Business.Shared.DTOs
@inherits ComponentBase

<div class="d-flex justify-content-between align-items-center mb-3" >
    <div class="w-50">
        <input type="text"
        class="form-control"
        placeholder="ابحث باسم العنصر..."
        @oninput="@(e => OnSearch.InvokeAsync(e.Value.ToString()))"
        value="@SearchText" />
    </div>
    @if (ShowButtonAddNew)
    {
        <button class="btn btn-success" @onclick="OnAdd">
            <i class="bi bi-plus-lg"></i> إضافة عنصر جديد
        </button>
    }
   
</div>

@code {
    [Parameter] public string SearchText { get; set; }
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public bool ShowButtonAddNew { get; set; }
}