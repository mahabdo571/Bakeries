@inherits ComponentBase
@using Business.Shared.DTOs
@using Business.Shared.Enums
@using Business.Shared.Enums.Extensions



@if (Item is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(Item.Id == 0 ? "إضافة " : "تعديل ")
                    </h5>
                    <button type="button" class="btn-close" @onclick="@OnClose"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="Item" OnValidSubmit="@HandleSave">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label">اسم العنصر</label>
                            <input type="text" class="form-control" value="@Product.Name" disabled />

                          
                        </div>  
                        
                        <div class="mb-3">
                            <label class="form-label">الوحدة</label>
                            <input type="text" class="form-control" value="@Product.UnitOfMeasure.GetDisplayName()" disabled />


                          
                        </div>


                        <div class="mb-3">
                            <label class="form-label">الكمية المنتجة</label>
                            <InputNumber class="form-control"
                                         @bind-Value="Item.QuantityProduced" />


                        </div>  
                        
                        <div class="mb-3">
                            <label class="form-label">الكمية التالفة</label>
                            <InputNumber class="form-control"
                                         @bind-Value="Item.QuantityDamaged" />


                        </div>

                 
                        <div class="mb-3">
                            <label class="form-label">الملاحظات</label>
                            <InputTextArea class="form-control" @bind-Value="Item.Notes" />
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">حفظ</button>
                            <button type="button" class="btn btn-secondary" @onclick="OnClose">إغلاق</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}


@code {




    [Parameter] public ProductionDTO Item { get; set; }
    [Parameter] public ProductDTO Product { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }




    private async Task HandleSave()
    {
        await OnSave.InvokeAsync();
    }


}