@using Business.Shared.DTOs
@using Microsoft.AspNetCore.Components.QuickGrid
@using Business.Shared.Enums.Extensions
<style>
    .quickgrid thead th {
        background-color: #000000; /* لون الخلفية المطلوب */
        color: white; /* لون النص */
    }



    .quickgrid th button {
        background-color: black !important; /* خلفية سوداء */
        color: white !important; /* النص باللون الأبيض */
        border: none; /* إزالة الحدود */
        padding: 8px 12px; /* تعديل الحواف */
        font-size: 16px;
        display: flex;
        align-items: center;
        gap: 5px; /* مسافة بين النص والسهم */
    }

        .quickgrid th button:hover {
            background-color: #333 !important; /* لون أغمق عند التحويم */
        }

    .quickgrid th[aria-sort="ascending"] button::after {
        content: ' ↑'; /* سهم للأعلى */
    }

    .quickgrid th[aria-sort="descending"] button::after {
        content: ' ↓'; /* سهم للأسفل */
    }

    .quickgrid th button::after {
        font-size: 14px;
    }

</style>


<div class="table-responsive">





    @if (Items == null)
    {
        <p colspan="10" class="text-center">جاري التحميل...</p>
    }
    else if (!Items.Any())
    {
        <p colspan="10" class="text-center">لا توجد بيانات</p>
    }
    else
    {
        <QuickGrid Items="Items" TGridItem="SalesDetailDTO" class="table-striped table-hover table">
            <PropertyColumn Property="@(e=>e.Id)" Title="#" Sortable="true" />
            <PropertyColumn Property="@(e=>e.ProductName)" Title="اسم المنتج" />
            <PropertyColumn Property="@(e=>e.UnitPrice)" class="d-none d-md-table-cell" Title="السعر" />
            <PropertyColumn Property="@(e=>e.Quantity)" class="d-none d-md-table-cell" Title="الكمية" />
            <PropertyColumn Property="@(e => e.Discount > 0 ? $"{e.Discount * 100} %" :"")" class="d-none d-md-table-cell" Title="نسبة الخصم" />
            <PropertyColumn Property="@(e=>e.Total)" class="d-none d-md-table-cell" Title="المجموع" />
            <PropertyColumn Property="@(e=>e.CreatedAt)" Sortable="true" Title="تاريخ الانشاء" />
            <PropertyColumn Property="@(e=>e.UpdatedAt)" Sortable="true" class="d-none d-md-table-cell" Title="تاريخ التحديث" />


            <TemplateColumn Context="item" Title="خيارات">


                <button class="btn btn-sm btn-warning me-1"
                @onclick:stopPropagation
                        @onclick="() => OnEdit.InvokeAsync(item)">
                    <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-sm btn-danger"
                @onclick:stopPropagation
                        @onclick="() => OnDelete.InvokeAsync(item)">
                    <i class="bi bi-trash"></i>
                </button>

                <button class="btn btn-sm btn-primary me-2"
                @onclick:stopPropagation
                        @onclick="() => OnDetails.InvokeAsync(item)">
                    <i class="bi bi-list-columns"></i>
                </button>

            </TemplateColumn>
        </QuickGrid>
    }

    <h3>المجموع الكلي: @totalSum</h3>

</div>

@code {


    [Parameter] public IQueryable<SalesDetailDTO> Items { get; set; }
    [Parameter] public EventCallback<SalesDetailDTO> OnDetails { get; set; }
    [Parameter] public EventCallback<SalesDetailDTO> OnEdit { get; set; }
    [Parameter] public EventCallback<SalesDetailDTO> OnDelete { get; set; }
    [Parameter] public decimal totalSum { get; set; }


   

}


