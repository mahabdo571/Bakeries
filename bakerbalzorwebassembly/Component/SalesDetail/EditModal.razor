@inherits ComponentBase
@using Business.Shared.DTOs
@using Business.Shared.Enums
@using Business.Shared.Enums.Extensions

@if (Item != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(Item.Id == 0 ? "اضافة عنصر جديدة" : "تعديل الطلب")
                    </h5>
                    <button type="button" class="btn-close" @onclick="@OnClose"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="Item" OnValidSubmit="@HandleSave">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label">اختر المنتج</label>
                           
                            <InputSelect TValue="int" class="form-control" @bind-Value="Item.FinishedProductInventoryId">
                                @foreach (var unit in Fpi)
                                {
                                    <option value="@unit.Id">@unit.ItemName</option>
                                }
                            </InputSelect>

                        </div>
                        <div class="mb-3">
                            <label class="form-label">الكمية</label>
                            <InputNumber  class="form-control" @bind-Value="@Item.Quantity" />
                        </div>     
                        
                        <div class="mb-3">
                            <label class="form-label">الخصم</label>
                            <InputNumber  class="form-control"  @bind-Value="@Item.Discount" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">الملاحظات</label>
                            <InputTextArea class="form-control" @bind-Value="@Item.Notes" />
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">حفظ</button>
                            <button type="button" class="btn btn-secondary" @onclick="@OnClose">إغلاق</button>
                        </div>

                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public SalesDetailDTO Item { get; set; }
    [Parameter] public List<FinishedProductInventoryDTO> Fpi { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }


    private async Task HandleSave()
    {
        await OnSave.InvokeAsync();
    }
}