@inherits ComponentBase
@using Business.Shared.DTOs
@using Business.Shared.Enums
@using Business.Shared.Enums.Extensions

@if (Item != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(Item.Id == 0 ? "اضافة طلبية جديدة" : "تعديل الطلب")
                    </h5>
                    <button type="button" class="btn-close" @onclick="@OnClose"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="Item" OnValidSubmit="@HandleSave">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label">رقم الطلب</label>
                            <InputNumber disabled="true" class="form-control" @bind-Value="@Item.Id" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">السعر الكلي</label>
                            <InputNumber disabled="true" class="form-control" @bind-Value="@Item.TotalAmount" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">عدد العناصر</label>
                            <InputNumber disabled="true" class="form-control" @bind-Value="@Item.TotalItems" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">طريقة الدفع</label>
                            <InputSelect class="form-control" @bind-Value="@Item.PaymentMethodId">
                                <option value="0">اختر طريقة الدفع</option>
                                @foreach (var unit in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@((int)unit)">@unit.GetDisplayName()</option>
                                }
                            </InputSelect>
                        </div>
                      
                        <div class="mb-3">
                            <label class="form-label">الملاحظات</label>
                            <InputTextArea class="form-control" @bind-Value="@Item.Notes" />
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">حفظ</button>
                            <button type="button" class="btn btn-secondary" @onclick="@OnClose">إغلاق</button>
                        </div>

                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public OrderDTO Item { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }


    private async Task HandleSave()
    {
        await OnSave.InvokeAsync();
    }
}